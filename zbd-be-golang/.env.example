# 항목 이름만 둔다 — 값은 .env.local(개발) 또는 서버 환경변수에. .env* 는 git 에 올리지 않는다.
PORT=5001
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONN_LIMIT=20
AES_256_ENCRYPTION_KEY=
AES_256_ENCRYPTION_IV=
AUTH_COOKIE_KEY=
PII_ENC_KEY_V1=
PII_INDEX_KEY=
CDN_UPLOAD_DIR=
# 올린 파일 주소 앞부분(운영 예: https://내도메인/upload/) — 비우면 /upload/
CDN_URL_PREFIX=
# 올린 파일 주소 앞부분(운영 예: https://내도메인/upload/) — 비우면 /upload/
OFFICE_IPS=
RUN_JOBS=
